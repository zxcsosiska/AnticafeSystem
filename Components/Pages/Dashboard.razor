@page "/dashboard"
@inject HttpClient Http

<div class="page-container">
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon">🟢</div>
            <div class="stat-info">
                <div class="stat-value">@_activeSessions</div>
                <div class="stat-label">Активных сеансов</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">💰</div>
            <div class="stat-info">
                <div class="stat-value">@_todayRevenue.ToString("N0") ₽</div>
                <div class="stat-label">Выручка сегодня</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">👥</div>
            <div class="stat-info">
                <div class="stat-value">@_totalGuests</div>
                <div class="stat-label">Гостей сегодня</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">⭐</div>
            <div class="stat-info">
                <div class="stat-value">@_currentTariff.ToString("0.00") ₽</div>
                <div class="stat-label">Цена за минуту</div>
            </div>
        </div>
    </div>
</div>

<style>
    .page-container { max-width: 1400px; margin: 0 auto; }
    .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
    .stat-card { background: #1a1a2e; border: 1px solid #2a2a4a; border-radius: 12px; padding: 20px 24px; display: flex; align-items: center; gap: 16px; }
    .stat-icon { font-size: 2.2rem; }
    .stat-info { display: flex; flex-direction: column; }
    .stat-value { font-size: 1.8rem; font-weight: 700; color: white; }
    .stat-label { color: #8888aa; font-size: 0.85rem; }
</style>

@code {
    private int _activeSessions = 0;
    private decimal _todayRevenue = 0;
    private int _totalGuests = 0;
    private decimal _currentTariff = 3.5m;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var sessions = await Http.GetFromJsonAsync<List<SessionDto>>("api/session/active");
            if (sessions != null) _activeSessions = sessions.Count;

            var today = DateTime.Now.ToString("yyyy-MM-dd");
            var report = await Http.GetFromJsonAsync<RevenueReport>($"api/report/revenue?from={today}&to={today}");
            if (report != null) { _todayRevenue = report.TotalRevenue; _totalGuests = report.SessionsCount; }

            var tariffJson = await Http.GetStringAsync("api/tariff/current");
            using var doc = System.Text.Json.JsonDocument.Parse(tariffJson);
            if (doc.RootElement.TryGetProperty("currentPricePerMinute", out var p))
                _currentTariff = p.GetDecimal();
        }
        catch { }
    }

    private class SessionDto { public int Id { get; set; } }
    private class RevenueReport { public decimal TotalRevenue { get; set; } public int SessionsCount { get; set; } }
}