@page "/sessions"
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<div class="container-fluid">
    <h2 class="mb-3">🪑 Сеансы</h2>

    <div class="card-glass mb-4">
        <div class="card-header-glass">➕ Новый сеанс</div>
        <div class="card-body-glass">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Имя гостя *</label>
                    <input @bind="_newGuestName" class="form-control-glass" placeholder="Иван Петров" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Телефон</label>
                    <input @bind="_newPhone" class="form-control-glass" placeholder="+7 999 123-45-67" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Стол</label>
                    <select @bind="_newTableNumber" class="form-control-glass">
                        @foreach (var t in _availableTables)
                        {
                            <option value="@t.TableNumber">Стол @t.TableNumber</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Длительность</label>
                    <select @bind="_newDuration" class="form-control-glass">
                        <option value="30">30 мин</option>
                        <option value="60">1 час</option>
                        <option value="90">1.5 ч</option>
                        <option value="120">2 ч</option>
                        <option value="180">3 ч</option>
                        <option value="240">4 ч</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button class="btn-primary-glass" @onclick="StartSession" disabled="@_isLoading">
                        @(_isLoading ? "⏳..." : "🚀 Начать")
                    </button>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(_errorMessage)) { <div class="alert-error-glass mt-3">@_errorMessage</div> }
            @if (!string.IsNullOrEmpty(_successMessage)) { <div class="alert-success-glass mt-3">✅ @_successMessage</div> }
        </div>
    </div>

    <div class="card-glass">
        <div class="card-header-glass">🟢 Активные (@_activeSessions.Count)</div>
        <div class="card-body-glass p-0">
            <table class="table-glass">
                <thead>
                    <tr><th>Гость</th><th>Стол</th><th>Начало</th><th>Стоимость</th><th>Действие</th></tr>
                </thead>
                <tbody>
                    @if (_activeSessions.Count == 0)
                    {
                        <tr><td colspan="5" class="text-center py-4 text-muted">Нет сеансов</td></tr>
                    }
                    else
                    {
                        @foreach (var s in _activeSessions)
                        {
                            <tr>
                                <td><strong>@s.GuestName</strong></td>
                                <td>Стол @s.TableNumber</td>
                                <td>@s.StartTime.ToString("HH:mm")</td>
                                <td>@s.TotalCost ₽</td>
                                <td><button class="btn-end" @onclick="() => EndSession(s.Id)">⏹ Завершить</button></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .container-fluid { padding: 20px; background: #0a0a1a; min-height: 100vh; }
    .card-glass { background: #1a1a2e; border: 1px solid #2a2a4a; border-radius: 12px; overflow: hidden; margin-bottom: 20px; }
    .card-header-glass { padding: 14px 20px; border-bottom: 1px solid #2a2a4a; color: white; font-weight: 600; }
    .card-body-glass { padding: 20px; }
    .card-body-glass.p-0 { padding: 0; }
    .form-label { color: rgba(255,255,255,0.6); font-size: 0.85rem; margin-bottom: 4px; display: block; }
    .form-control-glass { padding: 8px 12px; background: rgba(255,255,255,0.05); border: 1px solid #2a2a4a; border-radius: 8px; color: white; width: 100%; }
    .form-control-glass:focus { border-color: #667eea; outline: none; }
    .form-control-glass option { background: #1a1a2e; }
    .btn-primary-glass { padding: 8px 20px; background: linear-gradient(135deg, #667eea, #764ba2); color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; width: 100%; }
    .btn-primary-glass:disabled { opacity: 0.5; cursor: not-allowed; }
    .btn-end { padding: 4px 12px; background: rgba(255,107,122,0.15); border: 1px solid rgba(255,107,122,0.2); border-radius: 6px; color: #ff6b7a; cursor: pointer; }
    .alert-error-glass { padding: 10px 14px; background: rgba(255,107,122,0.1); border: 1px solid rgba(255,107,122,0.2); border-radius: 8px; color: #ff6b7a; }
    .alert-success-glass { padding: 10px 14px; background: rgba(56,239,125,0.1); border: 1px solid rgba(56,239,125,0.2); border-radius: 8px; color: #38ef7d; }
    .table-glass { width: 100%; border-collapse: collapse; }
    .table-glass th { padding: 10px 14px; text-align: left; color: rgba(255,255,255,0.4); font-size: 0.75rem; text-transform: uppercase; border-bottom: 1px solid #2a2a4a; }
    .table-glass td { padding: 10px 14px; border-bottom: 1px solid #1a1a3a; color: rgba(255,255,255,0.8); }
    .mt-3 { margin-top: 12px; } .mb-3 { margin-bottom: 12px; } .mb-4 { margin-bottom: 24px; }
    .text-center { text-align: center; } .text-muted { color: rgba(255,255,255,0.3); } .py-4 { padding: 24px 0; }
    .d-flex { display: flex; } .align-items-end { align-items: flex-end; }
    .row { display: flex; flex-wrap: wrap; gap: 12px; }
    .col-md-2 { flex: 0 0 calc(16.666% - 10px); }
    .col-md-3 { flex: 0 0 calc(25% - 10px); }
    @@media (max-width: 768px) { .col-md-2, .col-md-3 { flex: 0 0 100%; } }
</style>

@code {
    private List<SessionDto> _activeSessions = new();
    private List<TableDto> _availableTables = new();
    private string _newGuestName = "";
    private string _newPhone = "";
    private int _newDuration = 60;
    private int _newTableNumber = 1;
    private string _errorMessage = "";
    private string _successMessage = "";
    private bool _isLoading = false;
    private System.Timers.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await LoadAll();
        _timer = new System.Timers.Timer(5000);
        _timer.Elapsed += async (s, e) => await InvokeAsync(LoadAll);
        _timer.Start();
    }

    private async Task LoadAll()
    {
        try { _activeSessions = await Http.GetFromJsonAsync<List<SessionDto>>("api/session/active") ?? new(); } catch { }
        try
        {
            _availableTables = await Http.GetFromJsonAsync<List<TableDto>>("api/session/available-tables") ?? new();
            if (!_availableTables.Any())
            {
                _availableTables = await Http.GetFromJsonAsync<List<TableDto>>("api/session/tables") ?? new();
            }
            if (_availableTables.Any() && !_availableTables.Any(t => t.TableNumber == _newTableNumber))
                _newTableNumber = _availableTables.First().TableNumber;
        }
        catch { }
        StateHasChanged();
    }

    private async Task StartSession()
    {
        _errorMessage = ""; _successMessage = "";
        if (string.IsNullOrWhiteSpace(_newGuestName)) { _errorMessage = "❌ Введите имя"; return; }
        _isLoading = true;
        try
        {
            var request = new { guestName = _newGuestName.Trim(), phone = string.IsNullOrWhiteSpace(_newPhone) ? null : _newPhone.Trim(), tableNumber = _newTableNumber, roomId = 1, durationMinutes = _newDuration };
            var response = await Http.PostAsJsonAsync("api/session/start", request);
            if (response.IsSuccessStatusCode)
            {
                _successMessage = $"Сеанс для {_newGuestName} начат!";
                _newGuestName = ""; _newPhone = "";
                await LoadAll();
            }
            else
            {
                var content = await response.Content.ReadAsStringAsync();
                try { var err = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(content); _errorMessage = $"❌ {err?.error}"; }
                catch { _errorMessage = "❌ Ошибка"; }
            }
        }
        catch (Exception ex) { _errorMessage = $"❌ {ex.Message}"; }
        finally { _isLoading = false; StateHasChanged(); }
    }

    private async Task EndSession(int id)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Завершить?")) return;
        try
        {
            await Http.PostAsync($"api/session/end/{id}", null);
            await LoadAll();
        }
        catch { }
    }

    public void Dispose() => _timer?.Dispose();

    private class SessionDto { public int Id { get; set; } public string GuestName { get; set; } = ""; public int TableNumber { get; set; } public DateTime StartTime { get; set; } public decimal TotalCost { get; set; } }
    private class TableDto { public int Id { get; set; } public int TableNumber { get; set; } public int RoomId { get; set; } }
    private class ErrorResponse { public string? error { get; set; } }
}