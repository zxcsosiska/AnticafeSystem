@page "/settings"
@inject HttpClient Http

<div class="container-fluid">
    <h2 class="mb-3">⚙️ Настройки</h2>

    <div class="card-glass">
        <div class="card-header-glass">💰 Тариф</div>
        <div class="card-body-glass">
            <div class="row">
                <div class="col-md-3">
                    <label class="form-label">Цена за минуту</label>
                    <div class="input-group-glass">
                        <input @bind="_pricePerMinute" type="number" step="0.5" min="0.5" class="form-control-glass" />
                        <span class="input-group-text-glass">₽</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Минимум</label>
                    <div class="input-group-glass">
                        <input @bind="_minimumMinutes" type="number" min="30" step="15" class="form-control-glass" />
                        <span class="input-group-text-glass">мин</span>
                    </div>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button class="btn-primary-glass" @onclick="SaveSettings" disabled="@_isSaving">
                        @(_isSaving ? "⏳..." : "💾 Сохранить")
                    </button>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(_message)) { <div class="alert-success-glass mt-3">@_message</div> }
        </div>
    </div>
</div>

<style>
    .container-fluid { padding: 20px; background: #0a0a1a; min-height: 100vh; }
    .card-glass { background: #1a1a2e; border: 1px solid #2a2a4a; border-radius: 12px; overflow: hidden; }
    .card-header-glass { padding: 14px 20px; border-bottom: 1px solid #2a2a4a; color: white; font-weight: 600; }
    .card-body-glass { padding: 20px; }
    .form-label { color: rgba(255,255,255,0.6); font-size: 0.85rem; margin-bottom: 4px; display: block; }
    .form-control-glass { padding: 8px 12px; background: rgba(255,255,255,0.05); border: 1px solid #2a2a4a; border-radius: 8px; color: white; width: 100%; }
    .form-control-glass:focus { border-color: #667eea; outline: none; }
    .input-group-glass { display: flex; }
    .input-group-glass .form-control-glass { border-radius: 8px 0 0 8px; }
    .input-group-text-glass { padding: 8px 12px; background: rgba(255,255,255,0.05); border: 1px solid #2a2a4a; border-left: none; border-radius: 0 8px 8px 0; color: rgba(255,255,255,0.6); }
    .btn-primary-glass { padding: 8px 20px; background: linear-gradient(135deg, #667eea, #764ba2); color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; width: 100%; }
    .btn-primary-glass:disabled { opacity: 0.5; cursor: not-allowed; }
    .alert-success-glass { padding: 10px 14px; background: rgba(56,239,125,0.1); border: 1px solid rgba(56,239,125,0.2); border-radius: 8px; color: #38ef7d; }
    .mb-3 { margin-bottom: 12px; } .mt-3 { margin-top: 12px; }
    .d-flex { display: flex; } .align-items-end { align-items: flex-end; }
    .row { display: flex; flex-wrap: wrap; gap: 12px; }
    .col-md-3 { flex: 0 0 calc(25% - 10px); }
    @@media (max-width: 768px) { .col-md-3 { flex: 0 0 100%; } }
</style>

@code {
    private decimal _pricePerMinute = 3.5m;
    private int _minimumMinutes = 30;
    private string _message = "";
    private bool _isSaving = false;

    protected override async Task OnInitializedAsync() => await LoadSettings();

    private async Task LoadSettings()
    {
        try
        {
            var json = await Http.GetStringAsync("api/tariff/current");
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            if (doc.RootElement.TryGetProperty("currentPricePerMinute", out var p)) _pricePerMinute = p.GetDecimal();
            if (doc.RootElement.TryGetProperty("minimumMinutes", out var m)) _minimumMinutes = m.GetInt32();
            StateHasChanged();
        }
        catch { }
    }

    private async Task SaveSettings()
    {
        _isSaving = true; _message = "";
        try
        {
            await Http.PostAsJsonAsync("api/settings", new { key = "PricePerMinute", value = _pricePerMinute.ToString(System.Globalization.CultureInfo.InvariantCulture) });
            await Http.PostAsJsonAsync("api/settings", new { key = "MinimumMinutes", value = _minimumMinutes.ToString() });
            _message = "✅ Сохранено!";
            await LoadSettings();
        }
        catch (Exception ex) { _message = $"❌ {ex.Message}"; }
        finally { _isSaving = false; StateHasChanged(); }
    }
}