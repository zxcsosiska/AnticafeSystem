@page "/bookings"
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<div class="container-fluid">
    <h2 class="mb-3">📅 Бронирования</h2>

    <!-- ФОРМА СОЗДАНИЯ -->
    <div class="card-glass mb-4">
        <div class="card-header-glass">📝 Новое бронирование</div>
        <div class="card-body-glass">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Имя гостя *</label>
                    <input @bind="_newBookingGuest" class="form-control-glass" placeholder="Иван Петров" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Телефон</label>
                    <input @bind="_newBookingPhone" class="form-control-glass" placeholder="+7 999 123-45-67" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Дата</label>
                    <input type="date" @bind="_newBookingDate" class="form-control-glass" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Время</label>
                    <input type="time" @bind="_newBookingTime" class="form-control-glass" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Длительность</label>
                    <div class="input-group-glass">
                        <input type="number" @bind="_newBookingDuration" class="form-control-glass" min="30" step="15" />
                        <span class="input-group-text-glass">мин</span>
                    </div>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Стол</label>
                    <select @bind="_newBookingTable" class="form-control-glass">
                        @foreach (var table in _availableTables)
                        {
                            <option value="@table.TableNumber">Стол @table.TableNumber</option>
                        }
                    </select>
                </div>
            </div>
            <button class="btn-success-glass mt-3" @onclick="CreateBooking" disabled="@_isBookingLoading">
                @(_isBookingLoading ? "⏳..." : "📅 Забронировать")
            </button>
            
            @if (!string.IsNullOrEmpty(_bookingError))
            {
                <div class="alert-error-glass mt-3">@_bookingError</div>
            }
            @if (!string.IsNullOrEmpty(_bookingSuccess))
            {
                <div class="alert-success-glass mt-3">✅ @_bookingSuccess</div>
            }
        </div>
    </div>

    <!-- СПИСОК -->
    <div class="card-glass">
        <div class="card-header-glass">📋 Активные бронирования (@_activeBookings.Count)</div>
        <div class="card-body-glass p-0">
            <table class="table-glass">
                <thead>
                    <tr>
                        <th>Гость</th>
                        <th>Телефон</th>
                        <th>Стол</th>
                        <th>Дата</th>
                        <th>Время</th>
                        <th>Действие</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_activeBookings.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">Нет бронирований</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var b in _activeBookings)
                        {
                            <tr>
                                <td><strong>@b.GuestName</strong></td>
                                <td>@b.Phone</td>
                                <td>Стол @b.TableNumber</td>
                                <td>@b.BookingDate.ToString("dd.MM")</td>
                                <td>@b.StartTime</td>
                                <td>
                                    <button class="btn-cancel" @onclick="() => CancelBooking(b.Id)">
                                        ❌ Отменить
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .container-fluid { padding: 20px; background: #0a0a1a; min-height: 100vh; }
    .card-glass { background: #1a1a2e; border: 1px solid #2a2a4a; border-radius: 12px; overflow: hidden; margin-bottom: 20px; }
    .card-header-glass { padding: 14px 20px; border-bottom: 1px solid #2a2a4a; color: white; font-weight: 600; }
    .card-body-glass { padding: 20px; }
    .card-body-glass.p-0 { padding: 0; }
    
    .form-label { color: rgba(255,255,255,0.6); font-size: 0.85rem; margin-bottom: 4px; display: block; }
    .form-control-glass { padding: 8px 12px; background: rgba(255,255,255,0.05); border: 1px solid #2a2a4a; border-radius: 8px; color: white; width: 100%; }
    .form-control-glass:focus { border-color: #667eea; outline: none; }
    .form-control-glass option { background: #1a1a2e; }
    
    .input-group-glass { display: flex; }
    .input-group-glass .form-control-glass { border-radius: 8px 0 0 8px; }
    .input-group-text-glass { padding: 8px 12px; background: rgba(255,255,255,0.05); border: 1px solid #2a2a4a; border-left: none; border-radius: 0 8px 8px 0; color: rgba(255,255,255,0.6); }
    
    .btn-success-glass { padding: 8px 20px; background: #38ef7d; color: #0a0a1a; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; }
    .btn-success-glass:hover:not(:disabled) { background: #2dd86e; }
    .btn-success-glass:disabled { opacity: 0.5; cursor: not-allowed; }
    
    .btn-cancel { padding: 4px 12px; background: rgba(255,193,7,0.15); border: 1px solid rgba(255,193,7,0.2); border-radius: 6px; color: #ffc107; cursor: pointer; }
    .btn-cancel:hover { background: rgba(255,193,7,0.25); }
    
    .alert-error-glass { padding: 10px 14px; background: rgba(255,107,122,0.1); border: 1px solid rgba(255,107,122,0.2); border-radius: 8px; color: #ff6b7a; }
    .alert-success-glass { padding: 10px 14px; background: rgba(56,239,125,0.1); border: 1px solid rgba(56,239,125,0.2); border-radius: 8px; color: #38ef7d; }
    
    .table-glass { width: 100%; border-collapse: collapse; }
    .table-glass th { padding: 10px 14px; text-align: left; color: rgba(255,255,255,0.4); font-size: 0.75rem; text-transform: uppercase; border-bottom: 1px solid #2a2a4a; }
    .table-glass td { padding: 10px 14px; border-bottom: 1px solid #1a1a3a; color: rgba(255,255,255,0.8); }
    .table-glass tr:hover td { background: rgba(255,255,255,0.02); }
    
    .mt-3 { margin-top: 12px; }
    .mb-3 { margin-bottom: 12px; }
    .mb-4 { margin-bottom: 24px; }
    .text-center { text-align: center; }
    .text-muted { color: rgba(255,255,255,0.3); }
    .py-4 { padding: 24px 0; }
    .row { display: flex; flex-wrap: wrap; gap: 12px; }
    .col-md-2 { flex: 0 0 calc(16.666% - 10px); }
    .col-md-3 { flex: 0 0 calc(25% - 10px); }
    
    @@media (max-width: 768px) {
        .col-md-2, .col-md-3 { flex: 0 0 100%; }
    }
</style>

@code {
    private List<BookingDto> _activeBookings = new();
    private List<TableDto> _allTables = new();
    private List<TableDto> _availableTables = new();
    
    private string _newBookingGuest = "";
    private string _newBookingPhone = "";
    private DateTime _newBookingDate = DateTime.Now.Date;
    private TimeOnly _newBookingTime = new TimeOnly(19, 0);
    private int _newBookingDuration = 60;
    private int _newBookingTable = 1;
    private string _bookingError = "";
    private string _bookingSuccess = "";
    private bool _isBookingLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadBookings();
        await LoadTables();
        var now = DateTime.Now;
        _newBookingTime = new TimeOnly(now.Hour + 1, 0);
    }

    private async Task LoadBookings()
    {
        try
        {
            _activeBookings = await Http.GetFromJsonAsync<List<BookingDto>>("api/booking/active") ?? new();
            UpdateAvailableTables();
        }
        catch { }
    }

    private async Task LoadTables()
    {
        try
        {
            _allTables = await Http.GetFromJsonAsync<List<TableDto>>("api/session/tables") ?? new();
            _availableTables = _allTables;
            if (_allTables.Any()) _newBookingTable = _allTables.First().TableNumber;
        }
        catch { }
    }

    private void UpdateAvailableTables()
    {
        var busy = _activeBookings.Select(b => b.TableNumber).ToList();
        _availableTables = _allTables.Where(t => !busy.Contains(t.TableNumber)).ToList();
        if (!_availableTables.Any()) _availableTables = _allTables;
        StateHasChanged();
    }

    private async Task CreateBooking()
    {
        _bookingError = "";
        _bookingSuccess = "";
        
        if (string.IsNullOrWhiteSpace(_newBookingGuest))
        {
            _bookingError = "Введите имя гостя";
            return;
        }
        
        if (_newBookingDuration < 30)
        {
            _bookingError = "Минимум 30 минут";
            return;
        }

        _isBookingLoading = true;
        try
        {
            var request = new
            {
                guestName = _newBookingGuest.Trim(),
                phone = string.IsNullOrWhiteSpace(_newBookingPhone) ? "" : _newBookingPhone.Trim(),
                tableNumber = _newBookingTable,
                roomId = 1,
                bookingDate = _newBookingDate.ToString("yyyy-MM-dd"),
                startTime = _newBookingTime.ToString("HH:mm"),
                durationMinutes = _newBookingDuration
            };

            var response = await Http.PostAsJsonAsync("api/booking/create", request);
            
            if (response.IsSuccessStatusCode)
            {
                _bookingSuccess = $"✅ Бронирование для {_newBookingGuest} создано!";
                _newBookingGuest = "";
                _newBookingPhone = "";
                await LoadBookings();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                _bookingError = $"❌ Ошибка: {error}";
            }
        }
        catch (Exception ex)
        {
            _bookingError = $"❌ Ошибка: {ex.Message}";
        }
        finally
        {
            _isBookingLoading = false;
            StateHasChanged();
        }
    }

    private async Task CancelBooking(int id)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Отменить бронирование?")) return;
        
        try
        {
            await Http.DeleteAsync($"api/booking/cancel/{id}");
            await LoadBookings();
            await JSRuntime.InvokeVoidAsync("alert", "✅ Отменено");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Ошибка: {ex.Message}");
        }
    }

    private class BookingDto { public int Id { get; set; } public string GuestName { get; set; } = ""; public string Phone { get; set; } = ""; public int TableNumber { get; set; } public DateTime BookingDate { get; set; } public string StartTime { get; set; } = ""; }
    private class TableDto { public int Id { get; set; } public int TableNumber { get; set; } public int RoomId { get; set; } }

}